{
  "name": "@soft-advisor/pulumi-affected",
  "version": "0.5.0",
  "description": "Work out which Pulumi stacks a change affects, down to the functions each stack's program uses, so CI previews and deploys only those",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soft-advisor/pulumi-affected.git"
  },
  "keywords": [
    "pulumi",
    "monorepo",
    "affected",
    "ci",
    "github-actions",
    "preview"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "pulumi-affected": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema.json",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-action.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "lint": "biome check"
  },
  "dependencies": {
    "@yarnpkg/parsers": "3.0.3",
    "ajv": "8.17.1",
    "picomatch": "4.0.3",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "@types/picomatch": "4.0.2",
    "esbuild": "0.28.2"
  }
}
